(* Wave: renders audio samples into a Unicode braille oscilloscope, an
   8-bit binary waterfall, and standard RIFF WAVE audio files for cyk.

   It turns slices of 8-bit unsigned PCM samples ([]U8) into visual frames
   in a Buf.Buf—either a high-resolution oscilloscope drawn with Unicode
   braille characters (U+2800..U+28FF, 2x4 dots per terminal cell) or an
   8-bit bit-plane waterfall—and writes standard 44-byte RIFF WAVE header
   + PCM files.

   A braille cell has 2 columns by 4 rows of dots, numbered by bits 0..7
   of U+2800 + mask:

       col 0   col 1
       (01H)   (08H)   row 0
       (02H)   (10H)   row 1
       (04H)   (20H)   row 2
       (40H)   (80H)   row 3

   It depends on Buf, Str, Sys, Heap, Out and Rt (for its self-test main).

   It leaves out expression compilation (Beat) and terminal input and loop
   (Cyk). *)
module Wave;
import Buf, Str, Sys, Heap, Out, Rt;

const
    MaxCols* = 160;       (* maximum terminal columns supported *)
    MaxRows* = 32;        (* maximum terminal rows supported *)
    WavHeaderLen* = 44;   (* canonical 44-byte RIFF WAVE header size *)

    OpenFailed*: ERROR = "can't open file";
    WriteFailed*: ERROR = "can't write file";

    DotMask: [8]INT = [001H, 002H, 004H, 040H, 008H, 010H, 020H, 080H];

(* The smaller of a and b. *)
proc min(a, b: INT): INT;
begin
    if a < b then return a; end;
    return b;
end;

(* The larger of a and b. *)
proc max(a, b: INT): INT;
begin
    if a > b then return a; end;
    return b;
end;

(* Writes a 16-bit integer into buf at offset in little-endian byte order. *)
proc put16LE(var buf: [WavHeaderLen]U8; offset, val: INT);
begin
    buf[offset] := U8(val & 0FFH);
    buf[offset + 1] := U8((val shr 8) & 0FFH);
end;

(* Writes a 32-bit integer into buf at offset in little-endian byte order. *)
proc put32LE(var buf: [WavHeaderLen]U8; offset, val: INT);
begin
    buf[offset] := U8(val & 0FFH);
    buf[offset + 1] := U8((val shr 8) & 0FFH);
    buf[offset + 2] := U8((val shr 16) & 0FFH);
    buf[offset + 3] := U8((val shr 24) & 0FFH);
end;

(* Writes all bytes of data to fd, handling partial writes and signals. *)
proc writeAll(fd: INT; data: []U8): BOOL;
var at, n: INT;
begin
    at := 0;
    while at < LEN(data) do
        n := Sys.write(fd, data[at..LEN(data)]);
        if n > 0 then
            at := at + n;
        elsif n # Sys.errIntr then
            return false;
        end;
    end;
    return true;
end;

(* Appends the 3-byte UTF-8 encoding of Unicode braille pattern
   U+2800 + (mask & 0FFH) to b. *)
proc braille*(var b: Buf.Buf; mask: INT);
var m: INT;
begin
    m := mask & 0FFH;
    Buf.add(b, 0E2H);
    Buf.add(b, U8(0A0H + ((m shr 6) & 3)));
    Buf.add(b, U8(080H + (m & 03FH)));
end;

(* Renders one terminal row (row in 0 .. rows - 1, row = 0 at top) of width
   cols characters into b using Unicode braille characters. Connects consecutive
   vertical points to draw continuous waveforms. *)
proc scopeRow*(var b: Buf.Buf; samples: []U8; cols, rows, row: INT);
var
    hDots, vDots, c, dx, dy, x, idx, prevIdx: INT;
    yCur, yPrev, yLo, yHi, gy, mask: INT;
begin
    if (rows <= 0) or (cols <= 0) or (row < 0) or (row >= rows) then return; end;
    if LEN(samples) = 0 then
        for c := 0 to cols - 1 do braille(b, 0); end;
        return;
    end;
    hDots := cols * 2;
    vDots := rows * 4;
    for c := 0 to cols - 1 do
        mask := 0;
        for dx := 0 to 1 do
            x := c * 2 + dx;
            idx := x * LEN(samples) div hDots;
            yCur := (255 - INT(samples[idx])) * (vDots - 1) div 255;
            if x = 0 then
                yPrev := yCur;
            else
                prevIdx := (x - 1) * LEN(samples) div hDots;
                yPrev := (255 - INT(samples[prevIdx])) * (vDots - 1) div 255;
            end;
            yLo := min(yPrev, yCur);
            yHi := max(yPrev, yCur);
            for dy := 0 to 3 do
                gy := row * 4 + dy;
                if (gy >= yLo) and (gy <= yHi) then
                    mask := mask | DotMask[dx * 4 + dy];
                end;
            end;
        end;
        braille(b, mask);
    end;
end;

(* Renders one terminal row (row in 0 .. rows - 1) of the bit-plane waterfall
   across cols columns into b using Unicode braille. Dot row gy maps to bit
   7 - (gy * 8 div (rows * 4)) of sample at x. *)
proc bitsRow*(var b: Buf.Buf; samples: []U8; cols, rows, row: INT);
var
    hDots, vDots, c, dx, dy, x, idx, gy, bit, mask: INT;
    val: U8;
begin
    if (rows <= 0) or (cols <= 0) or (row < 0) or (row >= rows) then return; end;
    if LEN(samples) = 0 then
        for c := 0 to cols - 1 do braille(b, 0); end;
        return;
    end;
    hDots := cols * 2;
    vDots := rows * 4;
    for c := 0 to cols - 1 do
        mask := 0;
        for dx := 0 to 1 do
            x := c * 2 + dx;
            idx := x * LEN(samples) div hDots;
            val := samples[idx];
            for dy := 0 to 3 do
                gy := row * 4 + dy;
                bit := 7 - (gy * 8 div vDots);
                if bit < 0 then bit := 0;
                elsif bit > 7 then bit := 7;
                end;
                if ((INT(val) shr bit) & 1) # 0 then
                    mask := mask | DotMask[dx * 4 + dy];
                end;
            end;
        end;
        braille(b, mask);
    end;
end;

(* Renders one row of an 8-row bit-plane waterfall view across cols columns. *)
proc bitsRow8*(var b: Buf.Buf; samples: []U8; cols, row: INT);
begin
    bitsRow(b, samples, cols, 8, row);
end;

(* Writes a canonical 44-byte RIFF WAVE header for 8-bit unsigned mono PCM
   at rate Hz with numSamples bytes of sample data into hdr. *)
proc wavHeader*(var hdr: [WavHeaderLen]U8; rate, numSamples: INT);
begin
    COPY(hdr[0..4], "RIFF");
    put32LE(hdr, 4, 36 + numSamples);
    COPY(hdr[8..12], "WAVE");
    COPY(hdr[12..16], "fmt ");
    put32LE(hdr, 16, 16);
    put16LE(hdr, 20, 1);
    put16LE(hdr, 22, 1);
    put32LE(hdr, 24, rate);
    put32LE(hdr, 28, rate);
    put16LE(hdr, 32, 1);
    put16LE(hdr, 34, 8);
    COPY(hdr[36..40], "data");
    put32LE(hdr, 40, numSamples);
end;

(* Writes samples as an 8-bit unsigned mono PCM WAV file at rate Hz to path. *)
proc writeWav*(path: []U8; rate: INT; samples: []U8): ERROR;
var
    fd: INT;
    hdr: [WavHeaderLen]U8;
begin
    fd := Sys.create(path);
    if fd < 0 then return OpenFailed; end;
    wavHeader(hdr, rate, LEN(samples));
    if not writeAll(fd, hdr) then
        _ := Sys.closeChecked(fd);
        return WriteFailed;
    end;
    if (LEN(samples) > 0) and not writeAll(fd, samples) then
        _ := Sys.closeChecked(fd);
        return WriteFailed;
    end;
    if Sys.closeChecked(fd) # 0 then return WriteFailed; end;
    return nil;
end;

(* Computes the minimum, maximum, and average sample values of samples.
   Returns 0, 0, 0 when samples is empty. *)
proc stats*(samples: []U8): (INT, INT, INT);
var
    minVal, maxVal, sum, i, v: INT;
begin
    if LEN(samples) = 0 then return 0, 0, 0; end;
    minVal := INT(samples[0]);
    maxVal := INT(samples[0]);
    sum := 0;
    for i := 0 to LEN(samples) - 1 do
        v := INT(samples[i]);
        if v < minVal then minVal := v; end;
        if v > maxVal then maxVal := v; end;
        INC(sum, v);
    end;
    return minVal, maxVal, sum div LEN(samples);
end;

(* Tests little-endian 16-bit extraction. *)
proc get16LE(const buf: [WavHeaderLen]U8; offset: INT): INT;
begin
    return INT(buf[offset]) | (INT(buf[offset + 1]) shl 8);
end;

(* Tests little-endian 32-bit extraction. *)
proc get32LE(const buf: [WavHeaderLen]U8; offset: INT): INT;
begin
    return INT(buf[offset])
        | (INT(buf[offset + 1]) shl 8)
        | (INT(buf[offset + 2]) shl 16)
        | (INT(buf[offset + 3]) shl 24);
end;

(* Unit tests for Wave module. *)
proc main*;
var
    b: Buf.Buf;
    hdr: [WavHeaderLen]U8;
    samples: [256]U8;
    small: [3]U8;
    i, r, minVal, maxVal, avgVal: INT;
    s: []U8;
    err: ERROR;
begin
    Buf.init(b, Heap.heap);
    defer Buf.done(b);

    (* 1. Test braille encoding. *)
    braille(b, 0);
    s := Buf.bytes(b);
    if (LEN(s) # 3) or (s[0] # 0E2H) or (s[1] # 0A0H) or (s[2] # 080H) then
        Rt.stop("Wave: braille mask 0 failed");
    end;
    Buf.reset(b);
    braille(b, 0FFH);
    s := Buf.bytes(b);
    if (LEN(s) # 3) or (s[0] # 0E2H) or (s[1] # 0A3H) or (s[2] # 0BFH) then
        Rt.stop("Wave: braille mask 0FFH failed");
    end;

    (* 2. Test scopeRow and bitsRow on ramp and square wave. *)
    for i := 0 to 255 do
        samples[i] := U8(i);
    end;

    for r := 0 to 7 do
        Buf.reset(b);
        scopeRow(b, samples, 32, 8, r);
        s := Buf.bytes(b);
        if LEN(s) # 32 * 3 then Rt.stop("Wave: scopeRow byte length failed"); end;
        for i := 0 to 31 do
            if (s[i * 3] # 0E2H) or (s[i * 3 + 1] < 0A0H) or (s[i * 3 + 1] > 0A3H)
                or (s[i * 3 + 2] < 080H) or (s[i * 3 + 2] > 0BFH) then
                Rt.stop("Wave: scopeRow braille character invalid");
            end;
        end;
    end;

    for r := 0 to 7 do
        Buf.reset(b);
        bitsRow(b, samples, 32, 8, r);
        s := Buf.bytes(b);
        if LEN(s) # 32 * 3 then Rt.stop("Wave: bitsRow byte length failed"); end;
        for i := 0 to 31 do
            if (s[i * 3] # 0E2H) or (s[i * 3 + 1] < 0A0H) or (s[i * 3 + 1] > 0A3H)
                or (s[i * 3 + 2] < 080H) or (s[i * 3 + 2] > 0BFH) then
                Rt.stop("Wave: bitsRow braille character invalid");
            end;
        end;
    end;

    for i := 0 to 255 do
        if (i & 32) # 0 then samples[i] := 255; else samples[i] := 0; end;
    end;
    for r := 0 to 7 do
        Buf.reset(b);
        scopeRow(b, samples, 40, 8, r);
        if b.len # 40 * 3 then Rt.stop("Wave: scopeRow square len failed"); end;
        Buf.reset(b);
        bitsRow(b, samples, 40, 8, r);
        if b.len # 40 * 3 then Rt.stop("Wave: bitsRow square len failed"); end;
        Buf.reset(b);
        bitsRow8(b, samples, 40, r);
        if b.len # 40 * 3 then Rt.stop("Wave: bitsRow8 square len failed"); end;
    end;

    (* 3. Test wavHeader fields. *)
    wavHeader(hdr, 8000, 1024);
    if not Str.eq(hdr[0..4], "RIFF") then Rt.stop("Wave: wavHeader RIFF failed"); end;
    if get32LE(hdr, 4) # 36 + 1024 then Rt.stop("Wave: wavHeader file length failed"); end;
    if not Str.eq(hdr[8..12], "WAVE") then Rt.stop("Wave: wavHeader WAVE failed"); end;
    if not Str.eq(hdr[12..16], "fmt ") then Rt.stop("Wave: wavHeader fmt failed"); end;
    if get32LE(hdr, 16) # 16 then Rt.stop("Wave: wavHeader fmt chunk size failed"); end;
    if get16LE(hdr, 20) # 1 then Rt.stop("Wave: wavHeader audio format failed"); end;
    if get16LE(hdr, 22) # 1 then Rt.stop("Wave: wavHeader channels failed"); end;
    if get32LE(hdr, 24) # 8000 then Rt.stop("Wave: wavHeader sample rate failed"); end;
    if get32LE(hdr, 28) # 8000 then Rt.stop("Wave: wavHeader byte rate failed"); end;
    if get16LE(hdr, 32) # 1 then Rt.stop("Wave: wavHeader block align failed"); end;
    if get16LE(hdr, 34) # 8 then Rt.stop("Wave: wavHeader bits per sample failed"); end;
    if not Str.eq(hdr[36..40], "data") then Rt.stop("Wave: wavHeader data tag failed"); end;
    if get32LE(hdr, 40) # 1024 then Rt.stop("Wave: wavHeader data length failed"); end;

    (* 4. Test writeWav. *)
    err := writeWav("/tmp/wave-unit-test.wav", 8000, samples);
    if err # nil then Rt.stop("Wave: writeWav failed"); end;
    _ := Sys.remove("/tmp/wave-unit-test.wav");

    err := writeWav("/nonexistent-dir-for-wave-test/wave.wav", 8000, samples);
    if err # OpenFailed then Rt.stop("Wave: writeWav OpenFailed expected"); end;

    (* 5. Test stats. *)
    minVal, maxVal, avgVal := stats("");
    if (minVal # 0) or (maxVal # 0) or (avgVal # 0) then
        Rt.stop("Wave: stats empty failed");
    end;

    small[0] := 10;
    small[1] := 50;
    small[2] := 30;
    minVal, maxVal, avgVal := stats(small);
    if (minVal # 10) or (maxVal # 50) or (avgVal # 30) then
        Rt.stop("Wave: stats slice failed");
    end;

    Out.str("Wave: ok\n");
end;

end Wave.
