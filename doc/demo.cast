[4.95, "o", "\u001b[H\u001b[1mcyk\u001b[0m  [2/10] Crowd \u2014 viznut (2011)                   scope  8000 Hz  \u001b[32mplay\u001b[0m\r\n\u001b[2m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\r\n  \u001b[1mf(t) = \u001b[0m((t << 1) ^ ((t << 1) + (t >> a) & t >> b)) | t >> (4 - (1 ^ 7 \r\n  \u001b[2mknobs  \u001b[0ma = 7   b = 12   c = 19     \u001b[2mt = \u001b[0m512      \u001b[2mmin \u001b[0m68 \u001b[2mmax \u001b[0m255 \u001b[2mavg \u001b[0m168\r\n\u001b[2m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\r\n  \u001b[36m\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u28a0\u2824\u283c\u2809\u28b9\u2800\u2800\u2800\u2800\u2864\u2824\u280f\u2809\u2847\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u28b8\u2809\u2809\u2809\u28b9\u2800\u2800\u2800\u2800\u284f\u2809\u2809\u2809\u001b[0m\r\n  \u001b[36m\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u28b0\u2812\u281a\u2800\u2800\u2800\u28b8\u2800\u2800\u2856\u2812\u2803\u2800\u2800\u2800\u2847\u2800\u2800\u2800\u2800\u2800\u2800\u