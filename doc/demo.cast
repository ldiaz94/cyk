[14.62, "o", "\u001b[H\u001b[1mcyk\u001b[0m  [3/10] Sierpinski Harmony \u2014 viznut (2011)      scope  8000 Hz  \u001b[32mplay\u001b[0m\r\n\u001b[2m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\r\n  \u001b[1mf(t) = \u001b[0mt * (t >> 8 | t >> 9)\r\n  \u001b[2mknobs  \u001b[0ma = 7   b = 9   c = 4      \u001b[2mt = \u001b[0m3072       \u001b[2mmin \u001b[0m0 \u001b[2mmax \u001b[0m254 \u001b[2mavg \u001b[0m127\r\n\u001b[2m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\r\n  \u001b[36m\u2800\u2800\u2800\u2800\u2800\u28ff\u2800\u2800\u2800\u2880\u2840\u2800\u2800\u2800\u28b0\u2846\u2800\u2800\u2800\u28b8\u2847\u2800\u2800\u2800\u28c0\u2800\u2800\u2800\u2800\u28f6\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u28ff\u2800\u2800\u2800\u2880\u2840\u2800\u2800\u2800\u28b0\u2846\u2800\u2800\u2800\u28b8\u2847\u2800\u2800\u2800\u28c0\u2800\u2800\u2800\u2800\u28f6\u2800\u2800\u2800\u2800\u001b[0m\r\n  \u001b[36m\u2800\u2800\u2800\u2800\u28f0\u28bb\u2800\u2800\u2800\u28b8\u2847\u2800\u2800\u2800\u287c\u2847\u2800\u2800\u2800\u284f\u2847\u2800\u2800\u2880\u28ff\u2800\u2800\u2800\u28a0\u28bf\u2800\u2800\u2800\u28b8\u2847\u2800\u2800\u2800\u28f0\u28bb\u2800\u2800\u2800\u28b8\u2847\u2800\u2800\u2800\u287c\u2847\u2800\u2800\u2800\u284f\u2847\u2800\u2800\u2880\u28ff\u2800\u2800\u2800\u28a0\u28bf\u2800\u2800\u2800\u28b8\u001b[0m\r\n  \u001b[36m\u2800\u2800\u2800\u2800\u2847\u28b8\u2800\u2800\u28a0\u280f\u2847\u2800\u2800\u2880\u2847\u2847\u2800\u2800\u28b0\u2803\u2847\u2800\u2800\u28b8\u28b8\u2800\u2800\u2800\u287c\u28b8\u2800\u2800\u2800\u285e\u2847\u2800\u2800\u2800\u2847\u28b8\u2800\u2800\u28a0\u280f\u2847\u2800\u2800\u2880\u2847\u2847\u2800\u2800\u28b0\u2803\u2847\u2800\u2800\u28b8\u28b8\u2800\u2800\u2800\u287c\u28b8\u2800\u2800\u2800\u285e\u001b[0m\r\n  \u001b[36m\u2800\u2800\u2800\u28b8\u2801\u28b8\u2800\u2800\u28f8\u2800\u2847\u2800\u2800\u28b8\u2800\u2847\u2800\u2800\u287c\u2800\u2847\u2800\u2800\u284f\u28b8\u2800\u2800\u2880\u2847\u28b8\u2800\u2800\u28b0\u2803\u2847\u2800\u2800\u28b8\u2801\u28b8\u2800\u2800\u28f8\u2800\u2847\u2800\u2800\u28b8\u2800\u2847\u2800\u2800\u287c\u2800\u2847\u2800\u2800\u284f\u28b8\u2800\u2800\u2880\u2847\u28b8\u2800\u2800\u28b0\u2803\u001b[0m\r\n  \u001b[36m\u2800\u2800\u2800\u285e\u2800\u28b8\u2800\u2800\u2847\u2800\u2847\u2800\u28a0\u280f\u2800\u2847\u2800\u2880\u2847\u2800\u2847\u2800\u28b0\u2803\u28b8\u2800\u2800\u28b8\u2800\u28b8\u2800\u2800\u287c\u2800\u2847\u2800\u2800\u285e\u2800\u28b8\u2800\u2800\u2847\u2800\u2847\u2800\u28a0\u280f\u2800\u2847\u2800\u2880\u2847\u2800\u2847\u2800\u28b0\u2803\u28b8\u2800\u2800\u28b8\u2800\u28b8\u2800\u2800\u287c\u2800\u001b[0m\r\n  \u001b[36m\u2800\u2800\u28b0\u2803\u2800\u28b8\u2800\u28b8\u2801\u2800\u2847\u2800\u28f8\u2800\u2800\u2847\u2800\u285e\u2800\u2800\u2847\u2800\u287c\u2800\u28b8\u2800\u2800\u284f\u2800\u28b8\u2800\u2880\u2847\u2800\u2847\u2800\u28b0\u2803\u2800\u28b8\u2800\u28b8\u2801\u2800\u2847\u2800\u28f8\u2800\u2800\u2847\u2800\u285e\u2800\u2800\u2847\u2800\u287c\u2800\u28b8\u2800\u2800\u284f\u2800\u28b8\u2800\u2880\u2847\u2800\u001b[0m\r\n  \u001b[36m\u2800\u2800\u287c\u2800\u2800\u28b8\u2800\u284f\u2800\u2800\u2847\u2880\u2847\u2800\u2800\u2847\u28a0\u2807\u2800\u2800\u2847\u28a0\u2807\u2800\u28b8\u2800\u28b0\u2803\u2800\u28b8\u2800\u28b8\u2800\u2800\u2847\u2800\u287c\u2800\u2800\u28b8\u2800\u284f\u2800\u2800\u2847\u2880\u2847\u2800\u2800\u2847\u28a0\u2807\u2800\u2800\u2847\u28a0\u2807\u2800\u28b8\u2800\u28b0\u2803\u2800\u28b8\u2800\u28b8\u2800\u2800\u001b[0m\r\n  \u001b[36m\u2800\u2880\u2847\u2800\u2800\u28b8\u28b0\u2803\u2800\u2800\u2847\u28b8\u2800\u2800\u2800\u2847\u287c\u2800\u2800\u2800\u2847\u285e\u2800\u2800\u28b8\u2800\u285e\u2800\u2800\u28b8\u2800\u284f\u2800\u2800\u2847\u2880\u2847\u2800\u2800\u28b8\u28b0\u2803\u2800\u2800\u2847\u28b8\u2800\u2800\u2800\u2847\u287c\u2800\u2800\u2800\u2847\u285e\u2800\u2800\u28b8\u2800\u285e\u2800\u2800\u28b8\u2800\u284f\u2800\u2800\u001b[0m\r\n  \u001b[36m\u2800\u28f8\u2800\u2800\u2800\u28b8\u287c\u2800\u2800\u2800\u2847\u284f\u2800\u2800\u2800\u28c7\u2847\u2800\u2800\u2800\u28f7\u2803\u2800\u2800\u28b8\u28b8\u2801\u2800\u2800\u28b8\u28b8\u2801\u2800\u2800\u2847\u28f8\u2800\u2800\u2800\u28b8\u287c\u2800\u2800\u2800\u2847\u284f\u2800\u2800\u2800\u28c7\u2847\u2800\u2800\u2800\u28f7\u2803\u2800\u2800\u28b8\u28b8\u2801\u2800\u2800\u28b8\u28b8\u2801\u2800\u2800\u001b[0m\r\n  \u001b[36m\u2800\u2847\u2800\u2800\u2800\u2838\u2807\u2800\u2800\u2800\u28f7\u2803\u2800\u2800\u2800\u28ff\u2800\u2800\u2800\u2800\u283f\u2800\u2800\u2800\u28b8\u284f\u2800\u2800\u2800\u28b8\u285e\u2800\u2800\u2800\u2847\u2847\u2800\u2800\u2800\u2838\u2807\u2800\u2800\u2800\u28f7\u2803\u2800\u2800\u2800\u28ff\u2800\u2800\u2800\u2800\u283f\u2800\u2800\u2800\u28b8\u284f\u2800\u2800\u2800\u28b8\u285e\u2800\u2800\u2800\u001b[0m\r\n  \u001b[36m\u28f8\u2801\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u281b\u2800\u2800\u2800\u2800\u2809\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2818\u2803\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u28ff\u2801\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u281b\u2800\u2800\u2800\u2800\u2809\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2800\u2818\u2803\u2800\u2800\u2800\u2800\u2800\u