(* Cyk: the terminal bytebeat synthesizer, live formula editor, braille
   oscilloscope, and .wav recorder.

   Runs the interactive bytebeat studio in the terminal (or writes a .wav
   file or prints a deterministic screen frame in headless mode), feeding
   8,000 Hz 8-bit PCM to an audio player pipe if available while drawing a
   live braille oscilloscope or bit-plane waterfall.

   Layout of the screen frame:
   +--------------------------------------------------------------------+
   | cyk  [1/10] 42 Melody — viznut (2011)         scope  8000 Hz  play |
   | ────────────────────────────────────────────────────────────────── |
   |   f(t) = t * (a & (t >> b))                                        |
   |   knobs  a = 42   b = 10   c = 1    t = 0     min 0 max 168 avg 42 |
   | ────────────────────────────────────────────────────────────────── |
   |   <Unicode braille oscilloscope or bit-plane waterfall rows>       |
   | ────────────────────────────────────────────────────────────────── |
   |   [n/p] preset  [a/A b/B c/C] knobs  [v] view  [e] edit  [w] ...   |
   +--------------------------------------------------------------------+

   Depends on Beat, Wave, Buf, Fmt, Heap, Opt, Out, Rt, Str, Sys.

   Leaves out: floating-point synthesis, MIDI, and multi-track sequencing. *)
module Cyk;
import Beat, Wave, Buf, Fmt, Heap, Opt, Out, Rt, Str, Sys;

const
    MaxFormulaLen = 120; (* maximum length of formula text in edit mode *)
    FrameSamples = 256;  (* samples evaluated and displayed per frame *)
    StepSamples = 256;   (* samples stepped per '.' key press *)
    ViewScope = 0;       (* oscilloscope braille view mode *)
    ViewBits = 1;        (* bit-plane waterfall braille view mode *)
    DefaultCols = 72;    (* default screen columns in headless mode *)
    DefaultRows = 20;    (* default screen rows in headless mode *)

type
    (* Runtime state of the cyk synthesizer studio. *)
    State = record
        curTune: INT;               (* index of active preset (0..9) *)
        a, b, c: I64;               (* live knob values *)
        rate: INT;                  (* playback sample rate in Hz *)
        t: I64;                     (* current sample time counter *)
        prog: Beat.Prog;            (* active compiled program *)
        editBuf: [MaxFormulaLen]U8; (* formula text buffer *)
        editLen: INT;               (* formula text length in bytes *)
        errMsg: []U8;               (* compilation error message, or "" *)
        errPos: INT;                (* error column offset, or -1 *)
        viewMode: INT;              (* ViewScope or ViewBits *)
        paused: BOOL;               (* true when playback is paused *)
        editing: BOOL;              (* true when formula editor is active *)
        statusMsg: []U8;            (* transient status message, or "" *)
    end;

(* Emits ANSI dim style to b if color is enabled. *)
proc colDim(var b: Buf.Buf; color: BOOL);
begin
    if color then Buf.str(b, "\x1b[2m"); end;
end;

(* Emits ANSI waveform style (cyan) to b if color is enabled. *)
proc colWave(var b: Buf.Buf; color: BOOL);
begin
    if color then Buf.str(b, "\x1b[36m"); end;
end;

(* Emits ANSI bold style to b if color is enabled. *)
proc colBold(var b: Buf.Buf; color: BOOL);
begin
    if color then Buf.str(b, "\x1b[1m"); end;
end;

(* Emits ANSI error style (bright red) to b if color is enabled. *)
proc colErr(var b: Buf.Buf; color: BOOL);
begin
    if color then Buf.str(b, "\x1b[31;1m"); end;
end;

(* Resets ANSI style on b if color is enabled. *)
proc colReset(var b: Buf.Buf; color: BOOL);
begin
    if color then Buf.str(b, "\x1b[0m"); end;
end;

(* Ends a line on b. On a raw terminal it first erases what an earlier,
   longer frame left to the right, and adds the carriage return that a
   cooked terminal adds to '\n'. *)
proc endLine(var b: Buf.Buf; raw: BOOL);
begin
    if raw then Buf.str(b, "\x1b[K\r"); end;
    Buf.add(b, '\n');
end;

(* Ends the last line of a frame on b. A raw terminal gets no newline,
   which on the bottom row would scroll the header off the screen. *)
proc endFrame(var b: Buf.Buf; raw: BOOL);
begin
    if raw then Buf.str(b, "\x1b[K"); else Buf.add(b, '\n'); end;
end;

(* Parses terminal size in "COLSxROWS" format. *)
proc parseSize(s: []U8): (INT, INT, BOOL);
var
    a, b: []U8;
    c, r: I64;
    ok, okC, okR: BOOL;
begin
    a, b, ok := Str.cut(s, "x");
    if not ok then
        a, b, ok := Str.cut(s, "X");
    end;
    c, okC := Str.toInt(a);
    r, okR := Str.toInt(b);
    if not ok or not okC or not okR or (c < 20) or (c > 1000) or (r < 5) or (r > 1000) then
        return 0, 0, false;
    end;
    return INT(c), INT(r), true;
end;

(* Loads built-in preset i into s, restoring knobs, rate, and formula. *)
proc loadTune(var s: State; i: INT);
var
    tune: Beat.Tune;
begin
    tune := Beat.Tunes[i];
    s.curTune := i;
    s.a := tune.a;
    s.b := tune.b;
    s.c := tune.c;
    s.rate := tune.rate;
    s.t := 0;
    s.editLen := LEN(tune.formula);
    COPY(s.editBuf[0..s.editLen], tune.formula);
    _ := Beat.compile(tune.formula, s.prog);
    s.errMsg := "";
    s.errPos := -1;
    s.statusMsg := "";
end;

(* Compiles the edited formula buffer into candidate program and updates state. *)
proc compileEdit(var s: State);
var
    candProg: Beat.Prog;
    err: ERROR;
begin
    err := Beat.compile(s.editBuf[0..s.editLen], candProg);
    if err = nil then
        s.prog := candProg;
        s.errMsg := "";
        s.errPos := -1;
    else
        s.errMsg := MSG(err);
        s.errPos := candProg.errPos;
    end;
end;

(* Evaluates 5 seconds of the current formula from t = 0 and writes to cyk.wav. *)
proc saveWavFile(var s: State);
var
    b: Buf.Buf;
    chunk: []U8;
    total: INT;
    err: ERROR;
begin
    total := 5 * s.rate;
    Buf.init(b, Heap.heap);
    defer Buf.done(b);
    chunk := Buf.spare(b, total);
    if LEN(chunk) < total then
        Rt.stop("cyk: out of memory");
    end;
    Beat.fill(s.prog, 0, s.a, s.b, s.c, chunk);
    INC(b.len, total);
    err := Wave.writeWav("cyk.wav", s.rate, Buf.bytes(b));
    if err = nil then
        s.statusMsg := "saved cyk.wav (5s)";
    else
        s.statusMsg := "can't save cyk.wav";
    end;
end;

(* Processes one incoming keyboard byte, updating studio state or mode. *)
proc handleKey(var s: State; c: U8; var escState: INT; var running: BOOL);
begin
    if escState = 1 then
        if c = '[' then
            escState := 2;
            return;
        elsif c = 'O' then
            escState := 3;
            return;
        else
            escState := 0;
            if s.editing then
                s.editing := false;
            else
                running := false;
            end;
            if c = 27 then return; end;
        end;
    elsif escState >= 2 then
        (* CSI (2) skips parameter bytes 0x20..0x3F until a final byte;
           SS3 (3) takes one final byte. Arrows act only outside edit mode. *)
        if (escState = 2) and (c >= 32) and (c <= 63) then return; end;
        escState := 0;
        if not s.editing then
            if c = 'C' then
                loadTune(s, (s.curTune + 1) mod LEN(Beat.Tunes));
            elsif c = 'D' then
                loadTune(s, (s.curTune + LEN(Beat.Tunes) - 1) mod LEN(Beat.Tunes));
            end;
        end;
        return;
    end;

    if c = 27 then
        escState := 1;
        return;
    end;

    if s.editing then
        match c of
        | 10, 13:
            s.editing := false;
        | 8, 127:
            if s.editLen > 0 then
                DEC(s.editLen);
                compileEdit(s);
            end;
        | 21:
            s.editLen := 0;
            compileEdit(s);
        | else:
            if (c >= 32) and (c <= 126) and (s.editLen < MaxFormulaLen) then
                s.editBuf[s.editLen] := c;
                INC(s.editLen);
                compileEdit(s);
            end;
        end;
        return;
    end;

    match c of
    | 'q':
        running := false;
    | 'n':
        loadTune(s, (s.curTune + 1) mod LEN(Beat.Tunes));
    | 'p':
        loadTune(s, (s.curTune + LEN(Beat.Tunes) - 1) mod LEN(Beat.Tunes));
    | '1', '2', '3', '4', '5', '6', '7', '8', '9':
        loadTune(s, INT(c - '1'));
    | '0':
        loadTune(s, LEN(Beat.Tunes) - 1);
    | ' ':
        s.paused := not s.paused;
    | 'r':
        loadTune(s, s.curTune);
    | 'v':
        if s.viewMode = ViewScope then
            s.viewMode := ViewBits;
        else
            s.viewMode := ViewScope;
        end;
    | 'a':
        INC(s.a);
    | 'A':
        DEC(s.a);
    | 'b':
        INC(s.b);
    | 'B':
        DEC(s.b);
    | 'c':
        INC(s.c);
    | 'C':
        DEC(s.c);
    | '+', '=':
        s.rate := s.rate + 1000;
        if s.rate > 48000 then s.rate := 48000; end;
    | '-':
        s.rate := s.rate - 1000;
        if s.rate < 1000 then s.rate := 1000; end;
    | '.':
        s.t := s.t + StepSamples;
    | 'e', '/':
        s.editing := true;
    | 'w':
        saveWavFile(s);
    | else:
    end;
end;

const
    FormulaCol = 9;      (* column where formula text starts: 2 spaces and "f(t) = " *)
    CaretMinRows = 14;   (* fewest screen rows that have room for the caret row *)

(* Writes n spaces to b. *)
proc pad(var b: Buf.Buf; n: INT);
var i: INT;
begin
    for i := 1 to n do Buf.add(b, ' '); end;
end;

(* Writes the play state word, yellow when paused and green when playing. *)
proc playWord(var b: Buf.Buf; color, paused: BOOL; word: []U8);
begin
    if color then
        if paused then Buf.str(b, "\x1b[33m"); else Buf.str(b, "\x1b[32m"); end;
    end;
    Buf.str(b, word);
    colReset(b, color);
end;

(* Returns how many formula characters fit on a screen cols wide. *)
proc formulaWidth(cols: INT): INT;
begin
    if cols - FormulaCol < 1 then return 1; end;
    return cols - FormulaCol;
end;

(* Returns the screen column of the error caret, or -1 when there is no caret row. *)
proc caretCol(const s: State; cols, rows: INT): INT;
var offset: INT;
begin
    if not (s.editing and (s.errPos >= 0) and (rows >= CaretMinRows)) then return -1; end;
    offset := s.errPos;
    if s.editLen > formulaWidth(cols) then
        offset := offset - (s.editLen - formulaWidth(cols));
    end;
    if (offset >= 0) and (FormulaCol + offset < cols) then return FormulaCol + offset; end;
    return -1;
end;

(* Row 1: preset name on the left, view, rate and play state on the right. *)
proc headerRow(const s: State; var b: Buf.Buf; cols: INT; color, raw: BOOL);
var
    left, right: Buf.Buf;
    leftCols: INT;
    view, play: []U8;
begin
    Buf.init(left, Heap.heap);
    defer Buf.done(left);
    Buf.init(right, Heap.heap);
    defer Buf.done(right);

    Fmt.write(left, "cyk  [{}/{}] {} — {}",
        [Fmt.int(s.curTune + 1), Fmt.int(LEN(Beat.Tunes)),
         Fmt.str(Beat.Tunes[s.curTune].name), Fmt.str(Beat.Tunes[s.curTune].author)]);
    leftCols := left.len - 2; (* the dash is 3 bytes but 1 column *)
    if s.viewMode = ViewScope then view := "scope"; else view := "bits "; end;
    if s.paused then play := "pause"; else play := "play"; end;
    Fmt.write(right, "{}  {} Hz  {}", [Fmt.str(view), Fmt.int(s.rate), Fmt.str(play)]);

    colBold(b, color); Buf.str(b, "cyk"); colReset(b, color);
    Buf.str(b, Buf.bytes(left)[3..left.len]);
    if leftCols + right.len < cols then
        pad(b, cols - leftCols - right.len);
    else
        pad(b, 1);
    end;
    Buf.str(b, Buf.bytes(right)[0..right.len - LEN(play)]);
    playWord(b, color, s.paused, play);
    endLine(b, raw);
end;

(* A full-width horizontal rule. *)
proc divider(var b: Buf.Buf; cols: INT; color, raw: BOOL);
var i: INT;
begin
    colDim(b, color);
    for i := 1 to cols do Buf.str(b, "─"); end;
    colReset(b, color);
    endLine(b, raw);
end;

(* Row 3: the formula, scrolled to show its end while editing. *)
proc formulaRow(const s: State; var b: Buf.Buf; cols: INT; color, raw: BOOL);
var
    formula: []U8;
    width: INT;
begin
    formula := s.editBuf[0..s.editLen];
    width := formulaWidth(cols);
    Buf.str(b, "  ");
    colBold(b, color); Buf.str(b, "f(t) = "); colReset(b, color);
    if s.editing and (s.editLen > width) then
        Buf.str(b, formula[s.editLen - width..s.editLen]);
    elsif LEN(formula) > width then
        Buf.str(b, formula[0..width]);
    else
        Buf.str(b, formula);
    end;
    endLine(b, raw);
end;

(* The caret row: a ^ under the character where the formula fails to parse. *)
proc caretRow(var b: Buf.Buf; col: INT; color, raw: BOOL);
begin
    pad(b, col);
    colErr(b, color);
    Buf.add(b, '^');
    colReset(b, color);
    endLine(b, raw);
end;

(* A dim label followed by a plain number. *)
proc labelled(var b: Buf.Buf; color: BOOL; label: []U8; value: I64);
begin
    colDim(b, color); Buf.str(b, label); colReset(b, color);
    Fmt.write(b, "{}", [Fmt.int(value)]);
end;

(* Row 4: knobs at the left, time in the middle, sample stats at the right. *)
proc knobsRow(const s: State; var b: Buf.Buf; cols, minVal, maxVal, avgVal: INT; color, raw: BOOL);
var
    left, mid, right: Buf.Buf;
    gap, gap1, gap2: INT;
begin
    Buf.init(left, Heap.heap);
    defer Buf.done(left);
    Buf.init(mid, Heap.heap);
    defer Buf.done(mid);
    Buf.init(right, Heap.heap);
    defer Buf.done(right);

    (* plain copies, only to measure the widths *)
    Fmt.write(left, "  knobs  a = {}   b = {}   c = {}", [Fmt.int(s.a), Fmt.int(s.b), Fmt.int(s.c)]);
    Fmt.write(mid, "t = {}", [Fmt.int(s.t)]);
    Fmt.write(right, "min {} max {} avg {}", [Fmt.int(minVal), Fmt.int(maxVal), Fmt.int(avgVal)]);
    if left.len + mid.len + right.len + 2 <= cols then
        gap := cols - left.len - mid.len - right.len;
        gap1 := gap div 2;
        gap2 := gap - gap1;
    else
        gap1 := 1;
        gap2 := 1;
    end;

    Buf.str(b, "  ");
    colDim(b, color); Buf.str(b, "knobs  "); colReset(b, color);
    Fmt.write(b, "a = {}   b = {}   c = {}", [Fmt.int(s.a), Fmt.int(s.b), Fmt.int(s.c)]);
    pad(b, gap1);
    labelled(b, color, "t = ", s.t);
    pad(b, gap2);
    labelled(b, color, "min ", minVal);
    Buf.add(b, ' ');
    labelled(b, color, "max ", maxVal);
    Buf.add(b, ' ');
    labelled(b, color, "avg ", avgVal);
    endLine(b, raw);
end;

(* The waveform: count rows of the scope or bit-plane view. *)
proc waveRows(const s: State; var b: Buf.Buf; const samples: [FrameSamples]U8;
        cols, count: INT; color, raw: BOOL);
var r, waveCols: INT;
begin
    waveCols := cols - 4;
    if waveCols < 4 then waveCols := 4; end;
    for r := 0 to count - 1 do
        Buf.str(b, "  ");
        colWave(b, color);
        if s.viewMode = ViewScope then
            Wave.scopeRow(b, samples, waveCols, count, r);
        else
            Wave.bitsRow(b, samples, waveCols, count, r);
        end;
        colReset(b, color);
        endLine(b, raw);
    end;
end;

(* The last row: edit hint, error, status message or key help. *)
proc footerRow(const s: State; var b: Buf.Buf; color, raw: BOOL);
begin
    if s.editing then
        if LEN(s.errMsg) > 0 then
            colErr(b, color);
            Fmt.write(b, "  error: {} (Enter to finish, C-u to clear)", [Fmt.str(s.errMsg)]);
            colReset(b, color);
        else
            colBold(b, color);
            Buf.str(b, "  editing formula (Enter to finish, C-u to clear)");
            colReset(b, color);
        end;
    elsif LEN(s.errMsg) > 0 then
        colErr(b, color);
        Fmt.write(b, "  error: {}", [Fmt.str(s.errMsg)]);
        colReset(b, color);
    elsif LEN(s.statusMsg) > 0 then
        colBold(b, color);
        Fmt.write(b, "  {}", [Fmt.str(s.statusMsg)]);
        colReset(b, color);
    else
        colDim(b, color);
        Buf.str(b, "  [n/p] preset  [a/A b/B c/C] knobs  [v] view  [e] edit  [w] wav  [q] quit");
        colReset(b, color);
    end;
    endFrame(b, raw);
end;

(* Renders one complete studio screen frame of cols by rows into b. *)
proc render(const s: State; var b: Buf.Buf; cols, rows: INT; color, raw: BOOL);
var
    samples: [FrameSamples]U8;
    minVal, maxVal, avgVal, caret, count: INT;
begin
    Beat.fill(s.prog, s.t, s.a, s.b, s.c, samples);
    minVal, maxVal, avgVal := Wave.stats(samples);
    caret := caretCol(s, cols, rows);
    count := rows - 7;
    if caret >= 0 then DEC(count); end;
    if count < 1 then count := 1; end;

    headerRow(s, b, cols, color, raw);
    divider(b, cols, color, raw);
    formulaRow(s, b, cols, color, raw);
    if caret >= 0 then caretRow(b, caret, color, raw); end;
    knobsRow(s, b, cols, minVal, maxVal, avgVal, color, raw);
    divider(b, cols, color, raw);
    waveRows(s, b, samples, cols, count, color, raw);
    divider(b, cols, color, raw);
    footerRow(s, b, color, raw);
end;

(* Spawns an audio player child process with stdin connected to a pipe. *)
proc startAudio(rate: INT): (INT, INT);
var
    f: Sys.Info;
    err, pipeR, pipeW, rateLen, pid: INT;
    prog: Sys.Program;
    rateBuf: [20]U8;
    rateStr: []U8;
    args: [8][]U8;
begin
    _ := Sys.ignore(Sys.sigPipe, true);
    f, err := Sys.info("/usr/bin/aplay");
    if (err # 0) or f.dir then
        return -1, 0;
    end;
    pipeR, pipeW := Sys.pipe();
    if pipeR < 0 then return -1, 0; end;
    _ := Sys.keepOnExec(pipeR, true);

    rateBuf, rateLen := Str.fromInt(rate);
    rateStr := rateBuf[0..rateLen];

    args[0] := "aplay";
    args[1] := "-q";
    args[2] := "-f";
    args[3] := "U8";
    args[4] := "-r";
    args[5] := rateStr;
    args[6] := "-c";
    args[7] := "1";

    prog.path := "/usr/bin/aplay";
    prog.args := args[0..8];
    prog.fds[0] := pipeR;
    prog.fds[1] := 0;
    prog.fds[2] := 0;

    pid := Sys.spawn(prog);
    Sys.close(pipeR);
    if pid <= 0 then
        Sys.close(pipeW);
        return -1, 0;
    end;
    return pipeW, pid;
end;

(* Closes audio pipe and terminates the audio player process if running. *)
proc stopAudio(var audioFd, playerPid: INT);
begin
    if audioFd >= 0 then
        Sys.close(audioFd);
        audioFd := -1;
    end;
    if playerPid > 0 then
        _ := Sys.kill(playerPid, Sys.sigTerm);
        _, _, _ := Sys.wait(playerPid, false);
        playerPid := 0;
    end;
end;

(* Runs in headless test mode, reading keys from stdin and rendering the final frame. *)
proc runScreen(var s: State; cols, rows: INT): INT;
var
    b: Buf.Buf;
    keyBuf: [1]U8;
    n, escState: INT;
    running, useColor: BOOL;
begin
    Buf.init(b, Heap.heap);
    defer Buf.done(b);
    useColor := (Sys.isTerminal(Sys.stdout) or (LEN(Sys.env("CYK_COLOR")) > 0)) and (LEN(Sys.env("NO_COLOR")) = 0);
    running := true;
    escState := 0;
    while running do
        n := Sys.read(Sys.stdin, keyBuf);
        if n <= 0 then break; end;
        handleKey(s, keyBuf[0], escState, running);
    end;
    if escState = 1 then
        if s.editing then s.editing := false; else running := false; end;
    end;
    render(s, b, cols, rows, useColor, false);
    Out.str(Buf.bytes(b));
    return 0;
end;

const
    FrameMs = 33;        (* pause between frames; the clock, not this, paces audio *)
    LeadMs = 80;         (* audio written ahead of the clock, so the player never starves *)
    ChunkSamples = 1024; (* samples evaluated and written at a time *)

(* Writes all of data to fd, retrying after EINTR and short writes.
   Returns false on a real error. *)
proc writeAll(fd: INT; data: []U8): BOOL;
var n, done: INT;
begin
    done := 0;
    while done < LEN(data) do
        n := Sys.write(fd, data[done..LEN(data)]);
        if n = Sys.errIntr then
            continue;
        elsif n <= 0 then
            return false;
        end;
        done := done + n;
    end;
    return true;
end;

(* The samples the clock has moved on since the reading last, at rate.
   last moves on by the time those samples take, so the fraction of a
   sample left over counts in the next call. *)
proc samplesSince(var last: I64; rate: INT): I64;
var n: I64;
begin
    n := (Sys.clock() - last) * rate div 1000000000;
    last := last + n * 1000000000 div rate;
    return n;
end;

(* Evaluates samples from s.t up to target and writes them to audioFd
   (when it is open); s.t ends at target. Returns false if audio failed. *)
proc playTo(var s: State; audioFd: INT; target: I64): BOOL;
var
    chunk: [ChunkSamples]U8;
    n: INT;
begin
    while s.t < target do
        n := ChunkSamples;
        if target - s.t < n then n := INT(target - s.t); end;
        if audioFd >= 0 then
            Beat.fill(s.prog, s.t, s.a, s.b, s.c, chunk[0..n]);
            if not writeAll(audioFd, chunk[0..n]) then
                s.t := target;
                return false;
            end;
        end;
        s.t := s.t + n;
    end;
    return true;
end;

(* Runs the interactive bytebeat studio terminal loop. *)
proc runInteractive(var s: State; noAudio: BOOL): INT;
var
    b: Buf.Buf;
    keyBuf: [32]U8;
    cols, rows, tc, tr: INT;
    n, i, escState, audioFd, playerPid, lastAudioRate: INT;
    running, raw, useColor: BOOL;
    last: I64;
begin
    (* The loop takes the terminal's size each frame, when it has one. *)
    cols := DefaultCols;
    rows := DefaultRows;

    useColor := Sys.isTerminal(Sys.stdout) and (LEN(Sys.env("NO_COLOR")) = 0);

    audioFd := -1;
    playerPid := 0;
    lastAudioRate := s.rate;
    if not noAudio then
        audioFd, playerPid := startAudio(s.rate);
    end;

    (* The defer stands outside any if, which would run it at once; and
       restoring a terminal rawMode left alone changes nothing. *)
    raw := Sys.rawMode(Sys.stdin);
    defer Sys.restoreMode(Sys.stdin);

    (* Hide the cursor and turn off autowrap, so that a line too long for
       a small terminal is cut at its edge instead of scrolling. *)
    _ := Sys.write(Sys.stdout, "\x1b[?25l\x1b[?7l\x1b[2J\x1b[H");
    defer _ := Sys.write(Sys.stdout, "\x1b[?25h\x1b[?7h\x1b[0m\r\n");

    Buf.init(b, Heap.heap);
    defer Buf.done(b);

    running := true;
    escState := 0;
    (* Time moves on by what the clock says since the last frame, not
       from a fixed start, so keys may set t freely. The player is kept
       LeadMs ahead, written once when it starts. *)
    last := Sys.clock();
    _ := playTo(s, audioFd, s.t + s.rate * LeadMs div 1000);

    while running do
        tc, tr := Sys.termSize(Sys.stdout);
        if (tc > 0) and (tr > 0) then
            cols := tc;
            rows := tr;
        end;

        while Sys.ready(Sys.stdin, 0) do
            n := Sys.read(Sys.stdin, keyBuf);
            if n <= 0 then break; end;
            for i := 0 to n - 1 do
                handleKey(s, keyBuf[i], escState, running);
            end;
        end;
        if not running then break; end;

        if (escState = 1) and not Sys.ready(Sys.stdin, 25) then
            escState := 0;
            if s.editing then
                s.editing := false;
            else
                running := false;
            end;
            if not running then break; end;
        end;

        if (audioFd >= 0) and (s.rate # lastAudioRate) then
            stopAudio(audioFd, playerPid);
            audioFd, playerPid := startAudio(s.rate);
            lastAudioRate := s.rate;
            _ := playTo(s, audioFd, s.t + s.rate * LeadMs div 1000);
        end;

        (* While paused, t stands still and the clock's time is let go. *)
        if s.paused then
            last := Sys.clock();
        elsif not playTo(s, audioFd, s.t + samplesSince(last, s.rate)) then
            stopAudio(audioFd, playerPid);
        end;

        Buf.reset(b);
        Buf.str(b, "\x1b[H");
        render(s, b, cols, rows, useColor, raw);
        _ := Sys.write(Sys.stdout, Buf.bytes(b));

        Sys.sleep(FrameMs);
    end;

    if audioFd >= 0 then
        stopAudio(audioFd, playerPid);
    end;
    return 0;
end;

(* Main entry point: parses command line and runs studio, headless mode, or wav output. *)
proc main*: INT;
var
    p: Opt.Parser;
    s: State;
    formula, wavPath: []U8;
    hasFormula, extra, listPresets, screenMode, noAudio, ok: BOOL;
    hasA, hasB, hasC: BOOL;
    knobA, knobB, knobC: I64;
    preset, rate, duration, cols, rows, totalSamples: INT;
    audioBuf: Buf.Buf;
    chunk: []U8;
    err: ERROR;
    i: INT;
begin
    Opt.init(p, "cyk", [
        Opt.usage("", "cyk [option]... [formula]"),
        Opt.option("", 'p', "preset", "n", "start at preset n (1..10)"),
        Opt.option("", 'r', "rate", "hz", "sample rate, 1000..48000 (default 8000)"),
        Opt.option("", 'a', "", "n", "set knob a"),
        Opt.option("", 'b', "", "n", "set knob b"),
        Opt.option("", 'c', "", "n", "set knob c"),
        Opt.option("", 'w', "wav", "file", "write audio to a .wav file and exit"),
        Opt.option("", 'd', "duration", "sec", "seconds to write with -w, 1..300 (default 5)"),
        Opt.option("", 's', "screen", "COLSxROWS", "run keys from stdin, print the last frame"),
        Opt.option("", 'l', "list", "", "list the built-in presets and exit"),
        Opt.option("", 'n', "no-audio", "", "draw only, no sound")
    ]);

    preset := 1;
    rate := Beat.DefaultRate;
    duration := 5;
    cols := DefaultCols;
    rows := DefaultRows;

    while Opt.next(p) do
        if p.letter = 'p' then
            preset := INT(Opt.number(p, 1, 10));
        elsif p.letter = 'r' then
            rate := INT(Opt.number(p, 1000, 48000));
        elsif p.letter = 'a' then
            knobA := Opt.number(p, -1000000000, 1000000000);
            hasA := true;
        elsif p.letter = 'b' then
            knobB := Opt.number(p, -1000000000, 1000000000);
            hasB := true;
        elsif p.letter = 'c' then
            knobC := Opt.number(p, -1000000000, 1000000000);
            hasC := true;
        elsif p.letter = 'w' then
            wavPath := p.value;
        elsif p.letter = 'd' then
            duration := INT(Opt.number(p, 1, 300));
        elsif p.letter = 's' then
            cols, rows, ok := parseSize(p.value);
            if not ok then
                Opt.fail(p, "--screen wants colsxrows, such as 72x20");
            end;
            screenMode := true;
        elsif p.letter = 'l' then
            listPresets := true;
        elsif p.letter = 'n' then
            noAudio := true;
        end;
    end;

    formula, hasFormula := Opt.operand(p);
    _, extra := Opt.operand(p);
    if extra then
        Opt.fail(p, "too many arguments");
    end;

    if listPresets then
        for i := 0 to LEN(Beat.Tunes) - 1 do
            Fmt.print("{}  {} — {}\n   {}   [a={} b={} c={}]\n",
                [Fmt.int(i + 1), Fmt.str(Beat.Tunes[i].name), Fmt.str(Beat.Tunes[i].author),
                 Fmt.str(Beat.Tunes[i].formula),
                 Fmt.int(Beat.Tunes[i].a), Fmt.int(Beat.Tunes[i].b), Fmt.int(Beat.Tunes[i].c)]);
        end;
        return 0;
    end;

    loadTune(s, preset - 1);
    if hasA then s.a := knobA; end;
    if hasB then s.b := knobB; end;
    if hasC then s.c := knobC; end;
    if rate # Beat.DefaultRate then s.rate := rate; end;

    if hasFormula then
        if LEN(formula) > MaxFormulaLen then
            Fmt.eprint("cyk: formula too long (max {} chars)\n", [Fmt.int(MaxFormulaLen)]);
            return 1;
        end;
        s.editLen := LEN(formula);
        COPY(s.editBuf[0..s.editLen], formula);
        err := Beat.compile(formula, s.prog);
        if err # nil then
            Fmt.eprint("cyk: {}: {}\n", [Fmt.str(formula), Fmt.str(MSG(err))]);
            return 1;
        end;
    end;

    if LEN(wavPath) > 0 then
        totalSamples := duration * s.rate;
        Buf.init(audioBuf, Heap.heap);
        defer Buf.done(audioBuf);
        chunk := Buf.spare(audioBuf, totalSamples);
        if LEN(chunk) < totalSamples then
            Rt.stop("cyk: out of memory");
        end;
        Beat.fill(s.prog, 0, s.a, s.b, s.c, chunk);
        INC(audioBuf.len, totalSamples);
        err := Wave.writeWav(wavPath, s.rate, Buf.bytes(audioBuf));
        if err # nil then
            Fmt.eprint("cyk: can't write {}: {}\n", [Fmt.str(wavPath), Fmt.str(MSG(err))]);
            return 1;
        end;
        return 0;
    end;

    if screenMode then
        return runScreen(s, cols, rows);
    end;

    return runInteractive(s, noAudio);
end;

end Cyk.
